  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.3",
    "@types/react": "~18.3.23",
    "@types/react-native": "~0.73.0",
    "autoprefixer": "10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-expo": "^7.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "postcss": "8.5.1",
    "prettier": "^3.2.5",
    "typescript": "^5.5.3"
  },
  "private": true
